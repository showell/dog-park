// **WHAT DOG PARK SERVES BESIDES ITS CODE** (webbox's Phase B contract, as
// angry-gopher's zig-server/assets.zon): `.embedded`, files compiled in by
// name (physics.wasm, the page's physics, made by `zig build`), and
// `.site`, directories its routes read at request time from where it runs,
// relative to this file (solo/: the page and its script), each laid whole
// onto a machine's site disk.
.{
    .embedded = .{
        .{ .name = "physics.wasm", .path = "zig-out/web/physics.wasm", .built_by = "zig build" },
    },
    .site = .{"solo"},
}
