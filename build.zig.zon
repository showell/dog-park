.{
    .name = .dog_park,
    .version = "0.0.0",
    .fingerprint = 0x68c88f3759e4484,
    .minimum_zig_version = "0.17.0",
    .paths = .{ "build.zig", "build.zig.zon", "assets.zon", "src", "solo" },
    .dependencies = .{
        // The web-server-in-a-box library: zig-webbox, a sibling checkout
        // (../zig-webbox), modules `webbox`, `webbox_linux` and `host_io`.
        .webbox = .{ .path = "../zig-webbox" },
        // Shale, the script language for the park's own data: a sibling
        // checkout (../shale), module `shale`.
        .shale = .{ .path = "../shale" },
        // The kernel Dog Park runs on as a machine of its own (`zig build
        // metal`): zig-metal-unikernel, a sibling checkout, through its
        // public `addAppKernel`.
        // A path dependency, so every configure runs the kernel's build (~0.1 s warm, its git and
        // python checks): this repo builds only beside ../zig-metal-unikernel, as beside ../zig-webbox.
        .zig_metal_unikernel = .{ .path = "../zig-metal-unikernel", .lazy = true },
    },
}
