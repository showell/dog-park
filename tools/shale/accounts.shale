-- Dog Park's accounts against its 80 (players.zig's `most_players`), and
-- the games started: a game's `level` file is written at its player's
-- first load, so an account with none never played. Reads only.

const MOST = 80

local claimed = parse_int(read_or("players", "0"))
if claimed == nil then claimed = 0 print("the players file holds no number: read as 0") end
local games = 0
for name in ls("") do
  if starts_with(name, "game-") and exists(path(name, "level")) then games = games + 1 end
end
print("accounts " .. claimed .. " of " .. MOST .. ", " .. (MOST - claimed) .. " left")
print("games started " .. games .. ", accounts that never played " .. (claimed - games))
