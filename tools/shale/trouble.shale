-- Each game's trouble over the last hour, from its logs' entries: the
-- reports kept, the reports answered `differ` (the page and the server
-- disagreed), `req ?` (a header the server could not read), the overlaps
-- and drags with no drag on that reports' checks found, the times it was
-- stuck (the breaker tripped), and the lines refused. Each finding is an
-- `entry finding <n>` and its line (physics_log.zig).
--
-- A log is scanned a part at a time by the prelude's count_all and
-- find_next (one scan brings at most the call-bytes cap, and a log rotates
-- once it is past 1 MiB, so it may be a little more). A finding's line is
-- read whole (line_at), however long; a number in it that is none counts
-- 0, and a file in the folder whose name is no log's is passed by.

const HOUR_MS = 3600000

-- The findings and reports of one log, added to `t`.
function scan(log, t)
  t.reports = t.reports + count_all(log, "entry report ")
  local at = 0
  while true do
    local f = find_next(log, "entry finding ", at)
    if f == nil then break end
    -- The finding is the line after its entry's.
    local text = line_at(log, f + #line_at(log, f) + 1) or ""
    if starts_with(text, "req ? ") then
      t.unreadable = t.unreadable + 1
    elseif contains(text, " differ at tick ") then
      t.differs = t.differs + 1
    elseif starts_with(text, "stuck at ") then
      t.stuck = t.stuck + 1
    elseif starts_with(text, "refused, ") then
      t.refused = t.refused + 1
    elseif contains(text, " overlaps, ") then
      local w = words(text)
      t.overlaps = t.overlaps + (parse_int(get(w, 6)) or 0)
      t.idle_drags = t.idle_drags + (parse_int(get(w, 8)) or 0)
    end
    at = f + 1
  end
end

-- A log's start from its name, `log-<ms>`, or nil for a file that is no log.
function log_start(f)
  if not starts_with(f, "log-") then return nil end
  return parse_int(sub(f, 5))
end

local since = now() * 1000 - HOUR_MS
local rows = {}
for name in ls("") do
  local dir = path(name, "physics")
  if starts_with(name, "game-") and is_dir(dir) then
    local t = {game = name, logs = 0, reports = 0, differs = 0, unreadable = 0, overlaps = 0, idle_drags = 0, stuck = 0, refused = 0}
    -- The logs begun in the hour, and the one before them if it runs into it.
    local before = 0
    for f in ls(dir) do
      local started = log_start(f)
      if started ~= nil and started < since and started > before then before = started end
    end
    for f in ls(dir) do
      local started = log_start(f)
      if started ~= nil then
        local log = path(dir, f)
        -- The one before the hour counts only if it was still written in
        -- it (a host that keeps no time says 0: then it counts). Only it
        -- is stat'ed here: count_all stats each log it scans.
        local counts = started >= since
        if not counts and started == before then
          local m = stat(log).modified
          counts = m == 0 or m * 1000 >= since
        end
        if counts then
          t.logs = t.logs + 1
          scan(log, t)
        end
      end
    end
    push(rows, t)
  end
end
sort(rows, "game")
print(#rows .. " games, the last hour")
if #rows > 0 then print(table(rows, {"game", "logs", "reports", "differs", "unreadable", "overlaps", "idle_drags", "stuck", "refused"})) end
