// **THE PHYSICS HASH'S SOURCES** (physics_wire.zig's `physics_hash`): the
// files, by their path from src/play/, that decide a tick's lines and
// their text, and the page's exports: the Zig, and the Roc the physics
// links (build.zig's `roc_inputs`, the sources of the physics' Roc archives). build.zig computes a CRC-32 over them, in this order, at
// configure time.
.{
    "physics.zig",
    "physics_wire.zig",
    "tiles.zig",
    "layout.zig",
    "world.zig",
    "world.zon",
    "rules.zig",
    "rules.zon",
    "physics_page.zig",
    "roc_physics.zig",
    "grid.zig",
    "../../roc/physics.roc",
    "../../roc/platform/main.roc",
    "../../roc/Walk.roc",
    "../../roc/Wish.roc",
    "../../roc/World.roc",
    "../../roc/Rules.roc",
}
