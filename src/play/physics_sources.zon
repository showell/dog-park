// **THE PHYSICS HASH'S SOURCES** (physics_wire.zig's `physics_hash`): the
// files, in src/play/, that decide a tick's lines and their text, and the
// page's exports. build.zig computes a CRC-32 over them, in this order, at
// configure time.
.{
    "physics.zig",
    "physics_wire.zig",
    "tiles.zig",
    "layout.zig",
    "world.zig",
    "world.zon",
    "physics_page.zig",
}
