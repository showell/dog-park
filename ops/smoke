#!/bin/bash
# The smoke check: Dog Park built, started on a side port with a temporary
# config, asked for its page and three scenes (a first visit, then a claim
# and a drag with the cookie it set), its JSON checked, and stopped. Seconds.
#
#   ops/smoke            (from anywhere; exits non-zero on any failure)

set -euo pipefail

REPO_DIR="$(cd "$(dirname "$0")/.." && pwd)"
cd "$REPO_DIR"
# The browser's half, its pure parts, without a browser (163.4).
node ops/park_js_check.js
zig build

WORK="$(mktemp -d)"
SERVER_PID=""
cleanup() {
    if [ -n "$SERVER_PID" ]; then kill "$SERVER_PID" 2>/dev/null || true; wait "$SERVER_PID" 2>/dev/null || true; fi
    rm -rf "$WORK"
}
trap cleanup EXIT

# A free port, the kernel's choice.
PORT="$(python3 -c 'import socket; s=socket.socket(); s.bind(("127.0.0.1", 0)); print(s.getsockname()[1])')"
printf 'data_dir = %s/data\nauth_dir = %s/auth\n' "$WORK" "$WORK" > "$WORK/config"

DOGPARK_PORT="$PORT" DOGPARK_BIND=127.0.0.1 DOGPARK_CONFIG="$WORK/config" \
    zig-out/bin/dog-park > "$WORK/log" 2>&1 &
SERVER_PID=$!

URL="http://127.0.0.1:$PORT"
fail() { echo "smoke: FAIL: $*"; echo "--- server log:"; cat "$WORK/log"; exit 1; }
# Every request has five seconds: a server that accepts and never answers
# fails the smoke, never hangs it.
curl() { command curl -m 5 "$@"; }
for _ in $(seq 1 100); do
    kill -0 "$SERVER_PID" 2>/dev/null || fail "the server stopped as it started (the port taken?)"
    curl -s -o /dev/null "$URL/" && break
    sleep 0.05
done
kill -0 "$SERVER_PID" 2>/dev/null || fail "the server is not running"

curl -sf "$URL/" | grep -q '<script src="/park.js?h=' || fail "GET / does not name its script"
curl -sf -o /dev/null "$URL/park.js" || fail "GET /park.js"

STAY='{"viewport_plane_x":2300,"viewport_plane_y":2300,"viewport_width":400,"viewport_height":300,"move":{"stay":{}}}'
DRAG='{"viewport_plane_x":2300,"viewport_plane_y":2300,"viewport_width":400,"viewport_height":300,"move":{"drag":{"own_dog_dx":25,"own_dog_dy":-15}}}'
curl -sf -c "$WORK/jar" -H 'content-type: application/json' -d "$STAY" "$URL/scene" > "$WORK/first.json" || fail "the first POST /scene"
grep -q dogpark_human "$WORK/jar" || fail "the first scene set no cookie"
# A first visit is given a dog, provisionally; the next request, with its
# cookie, is the same dog; the one after drags it, and holds it for good
# (docs/CLAIMS-V1.md).
curl -sf -b "$WORK/jar" -H 'content-type: application/json' -d "$STAY" "$URL/scene" > "$WORK/claim.json" || fail "the second POST /scene"
curl -sf -b "$WORK/jar" -H 'content-type: application/json' -d "$DRAG" "$URL/scene" > "$WORK/second.json" || fail "the dragging POST /scene"

python3 - "$WORK/first.json" "$WORK/second.json" <<'PY' || fail "the scenes' JSON"
import json, sys
first = json.load(open(sys.argv[1]))["scene"]
second = json.load(open(sys.argv[2]))["scene"]
mine, moved = first["own"]["has_dog"], second["own"]["has_dog"]
assert mine["move"] == "stayed" and mine["is"] == "new_dog", mine
assert moved["move"] == "moved" and moved["is"] == "same_dog", moved
# The same human's dog, the one given, moved by the drag.
assert (moved["plane_x"], moved["plane_y"]) == (mine["plane_x"] + 25, mine["plane_y"] - 15), (mine, moved)
assert second["park_width"] == 5000 and second["park_height"] == 5000
assert second["others_complete"] == "all"
PY

[ "$(ls "$WORK/data/dogs" | wc -l)" = 400 ] || fail "the park's 400 dogs were not made"
echo "smoke: ok (port $PORT)"
